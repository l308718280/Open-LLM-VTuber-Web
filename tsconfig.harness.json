{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": [],
    "rootDir": "src/renderer/src/harness",
    "outDir": "node_modules/.tmp/harness-tests",
    "noEmitOnError": true
  },
  "include": ["src/renderer/src/harness/**/*.ts"]
}